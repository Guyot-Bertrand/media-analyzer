{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "transport-bench",
  "version": "0.1.0",
  "identifier": "dev.media-analyzer.transport-bench",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Banc du transport d'image",
        "width": 1920,
        "height": 1080,
        "resizable": false,
        "decorations": false,
        "fullscreen": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"]
  }
}
